# Resend Email API Key (Get from resend.com)
RESEND_API_KEY=re_your_api_key_here

# Vercel Flags / Feature Flags
# Set to 'false' to hide the Kiro collaboration badge and elevate the HackIEEE title
SHOW_KIRO_COLLABORATION=true
# (Optional) Secret for Vercel Toolbar Flags Explorer
# FLAGS_SECRET=
IS_REGISTRATION_ACTIVE=true

# Supabase Database Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret service role key (bypasses RLS for backend registration inserts):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
