# ── Supabase Database Configuration ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Resend Email API Key (Get from resend.com) ──
RESEND_API_KEY=re_your_api_key_here

# ── Feature Flags ──
# Controls HackIEEE 2026-27 Registration:
# - 'false' (default): Registration closed (Navbar has Contact Us, Hero has Tracks/Timeline, direct /register and /api/register return 403)
# - 'true': Registration active (Navbar displays Register/Login, Hero displays Register CTA, forms and API unlocked)
IS_REGISTRATION_ACTIVE=false

# Controls Kiro Collaboration badge visibility ('true' | 'false')
SHOW_KIRO_COLLABORATION=false

# (Optional) Secret for Vercel Toolbar Flags Explorer
# FLAGS_SECRET=
IS_REGISTRATION_ACTIVE=true

# Supabase Database Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret service role key (bypasses RLS for backend registration inserts):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
