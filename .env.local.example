# ==============================================================================
# HackIEEE 2026-27: Local Environment Configuration (.env.local)
# ==============================================================================

# ── 1. Supabase Database Configuration ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret service role key (bypasses RLS for backend registration inserts and admin verification)
# Get from: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY= 
# ── 2. Resend Email Configuration ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=HackIEEE <noreply@hack.ieeenirma.org>

# ── 3. Feature Flags & Navigation Controls ──

# Primary Navbar & Authentication Mode:
# Options:
#   - "both"              : Shows [Login] on left and [Register] CTA on right (Default active)
#   - "registration_only" : Shows [Register] CTA on right only
#   - "login_only"        : Shows [Login] button on right only
#   - "none"              : Shows [Contact Us] only (Registration closed)
AUTH_NAV_MODE=registration_only

# Backward-compatible toggle for registration active state:
IS_REGISTRATION_ACTIVE=true

# Kiro Collaboration Badge in Hero:
SHOW_KIRO_COLLABORATION=true