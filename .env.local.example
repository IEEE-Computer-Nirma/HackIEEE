# ==============================================================================
# HackIEEE 2027: Environment Variables & Feature Flags Template
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.local.example .env.local
# ==============================================================================

# ── 1. Supabase Database Configuration ──
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Secret service role key (bypasses RLS for secure server-side admin / registration operations)
# Keep strictly secret — NEVER expose with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ── 2. Resend Email Configuration (resend.com) ──
RESEND_API_KEY=re_your_api_key_here

# Verified Sender Address (configure custom domain at resend.com/domains):
# e.g., "HackIEEE <noreply@hack.ieeenirma.org>" or "HackIEEE <no-reply@ieeenirma.org>"
RESEND_FROM_EMAIL=HackIEEE <noreply@hack.ieeenirma.org>

# (Optional) Support / reply-to destination for inbound attendee replies
# RESEND_REPLY_TO=deep@computer.org

# ── 3. Google OAuth 2.0 Credentials (console.cloud.google.com) ──
# Configured in: Google Cloud Console -> APIs & Services / Google Auth Platform -> Clients
# Also configure in: Supabase Dashboard -> Authentication -> Providers -> Google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# ── 4. Feature Flags & Navigation Controls ──

# Primary Navbar & Authentication Mode:
# Controls which authentication & action buttons appear across the site.
# Available values:
#   - "both"              : Shows [Login] on left and [Register] CTA on the right
#   - "registration_only" : Shows [Register] CTA on the right only (Default active mode)
#   - "login_only"        : Shows [Login] button on the right only
#   - "none"              : Shows [Contact Us] only (Registration closed; /register redirects / 403s)
AUTH_NAV_MODE=registration_only

# Backward-compatible toggle for registration active state:
# Setting this to 'false' automatically sets AUTH_NAV_MODE to 'none' if AUTH_NAV_MODE is unset.
IS_REGISTRATION_ACTIVE=true

# ── KIRO Supported By: 3 Flag-Based Trial Variants (on/off) ───────────────────
# Master toggle: Set to 'false' to disable all KIRO placements at once.
SHOW_KIRO_COLLABORATION=true

# Variant 1 (Default: false): Prominent 2-line obsidian badge in Hero above HackIEEE
SHOW_KIRO_IN_HERO=false

# Variant 2 (Default: false): "Supported by" section in About directly above "Organised by"
SHOW_KIRO_IN_ABOUT=false

# Variant 3 (Default: true - Active): Sleek bar badge in top left beside navigation header
SHOW_KIRO_IN_NAV=true

# (Optional) Vercel Toolbar Flags Explorer secret key for testing overrides on preview deployments
# FLAGS_SECRET=
