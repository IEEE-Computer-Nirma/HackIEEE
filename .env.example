# ---------------------------------------------------------------------------
# HackIEEE — Environment Variables Example
#
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------------------

# Resend API key (required for sending emails).
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_api_key
RESEND_FROM_EMAIL="HackIEEE <hack@ieeenirma.org>"
HACKIEEE_WEBSITE_URL=https://hack.ieeenirma.org

# Sender address shown to recipients.
# Must be a verified domain in your Resend account.
# Defaults to: HackIEEE <hack@ieeenirma.org>
# RESEND_FROM_EMAIL=HackIEEE <hack@ieeenirma.org>

# Public website URL included as a CTA link in outgoing emails.
# Official website: https://hack.ieeenirma.org
# Omit or leave blank to suppress the CTA button entirely.
# HACKIEEE_WEBSITE_URL=https://hack.ieeenirma.org
